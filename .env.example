# Local GigaAM STT configuration
GIGAAM_MODEL=e2e_rnnt
# Leave empty to use CUDA when available, otherwise CPU.
GIGAAM_DEVICE=
GIGAAM_BATCH_SIZE=4
GIGAAM_MIN_DURATION_ON=0.0
GIGAAM_MIN_DURATION_OFF=0.0

# Windows FFmpeg shared bin directory
FFMPEG_BIN=C:\ffmpeg8\bin

# Hugging Face token is required only for the first download of the
# pyannote/segmentation-3.0 VAD model after accepting its access terms.
HF_TOKEN=

# Local llama.cpp server; only loopback URLs are allowed.
GIGACHAT_BASE_URL=http://127.0.0.1:8080
