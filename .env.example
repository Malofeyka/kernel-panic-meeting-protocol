# Local GigaAM STT configuration
GIGAAM_MODEL=e2e_rnnt
# Leave empty to use CUDA when available, otherwise CPU.
GIGAAM_DEVICE=
GIGAAM_BATCH_SIZE=4
GIGAAM_MIN_DURATION_ON=0.0
GIGAAM_MIN_DURATION_OFF=0.0

# Windows FFmpeg shared bin directory
FFMPEG_BIN=C:\ffmpeg8\bin

# Hugging Face token is required only for the first download of the
# pyannote/segmentation-3.0 VAD model after accepting its access terms.
HF_TOKEN=

# Local llama.cpp server; only loopback URLs are allowed.
GIGACHAT_BASE_URL=http://127.0.0.1:8080

# --- Backend (сессии, извлечение, экспорт) ---
# Каталог хранения сессий, загруженных файлов и сформированных протоколов
DATA_DIR=data
MAX_UPLOAD_MB=1024
MAX_REVISION_CYCLES=2
# Размер фрагмента стенограммы для одного запроса к LLM (символы) и перекрытие (сегменты)
LLM_CHUNK_CHARS=6000
LLM_CHUNK_OVERLAP_SEGMENTS=2
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.0
# true — пункты без подтверждающей цитаты исключаются из проекта (попадают в аналитику)
DROP_UNGROUNDED_ITEMS=true
ASSIGNEE_OVERLOAD_THRESHOLD=5
ORGANIZATION_NAME=Министерство образования Свердловской области
ORGANIZATION_CITY=г. Екатеринбург
# Источники фронтенда для CORS (через запятую)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
